# Your team names (comma-separated)
# These should match exactly as they appear on the DDLC website
TEAM_NAMES=L'Antichambre (B3),L'Antichambre (B2)

# Season label to select on the DDLC calendar page.
# Must match exactly the dropdown option, e.g.:
#   Adulte | ÉTÉ 2026
#   Adulte | Automne/Hiver 2025-2026
SEASON=Adulte | ÉTÉ 2026

# "gab" mode (run with: python main.py gab). Uses the same SEASON above.
# Teams to look for in gab mode (comma-separated, matched exactly).
GAB_TEAM_NAMES=L'antichambre (F6+),Survivor
# Shared calendars to write into, by venue. Events are titled after your team.
GAB_CALENDAR_STAUG=Dek St-Aug GAB
GAB_CALENDAR_CHAUVEAU=Dek Chauveau GAB
